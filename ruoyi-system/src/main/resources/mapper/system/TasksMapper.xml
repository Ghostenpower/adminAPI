<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TasksMapper">
    
    <resultMap type="Tasks" id="TasksResult">
        <result property="taskId"    column="task_id"    />
        <result property="userId"    column="user_id"    />
        <result property="taskType"    column="task_type"    />
        <result property="title"    column="title"    />
        <result property="description"    column="description"    />
        <result property="pickupLocation"    column="pickup_location"    />
        <result property="deliveryLocation"    column="delivery_location"    />
        <result property="deadline"    column="deadline"    />
        <result property="status"    column="status"    />
        <result property="paymentStatus"    column="payment_status"    />
        <result property="remark"    column="remark"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="imagesUrl"    column="images_url"    />
        <result property="pickupCoordinates"    column="pickup_coordinates"    />
        <result property="deliveryCoordinates"    column="delivery_coordinates"    />
        <result property="price"    column="price"    />
    </resultMap>

    <sql id="selectTasksVo">
        select task_id, user_id, task_type, title, description, pickup_location, delivery_location, deadline, status, payment_status, remark, created_at, updated_at, images_url, pickup_coordinates, delivery_coordinates, price from tasks
    </sql>

    <select id="selectTasksList" parameterType="Tasks" resultMap="TasksResult">
        <include refid="selectTasksVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="taskType != null "> and task_type = #{taskType}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="pickupLocation != null  and pickupLocation != ''"> and pickup_location = #{pickupLocation}</if>
            <if test="deliveryLocation != null  and deliveryLocation != ''"> and delivery_location = #{deliveryLocation}</if>
            <if test="deadline != null "> and deadline = #{deadline}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="paymentStatus != null "> and payment_status = #{paymentStatus}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
            <if test="imagesUrl != null  and imagesUrl != ''"> and images_url = #{imagesUrl}</if>
            <if test="pickupCoordinates != null  and pickupCoordinates != ''"> and pickup_coordinates = #{pickupCoordinates}</if>
            <if test="deliveryCoordinates != null  and deliveryCoordinates != ''"> and delivery_coordinates = #{deliveryCoordinates}</if>
            <if test="price != null "> and price = #{price}</if>
        </where>
    </select>
    
    <select id="selectTasksByTaskId" parameterType="Long" resultMap="TasksResult">
        <include refid="selectTasksVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertTasks" parameterType="Tasks" useGeneratedKeys="true" keyProperty="taskId">
        insert into tasks
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="taskType != null">task_type,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="pickupLocation != null and pickupLocation != ''">pickup_location,</if>
            <if test="deliveryLocation != null and deliveryLocation != ''">delivery_location,</if>
            <if test="deadline != null">deadline,</if>
            <if test="status != null">status,</if>
            <if test="paymentStatus != null">payment_status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="imagesUrl != null and imagesUrl != ''">images_url,</if>
            <if test="pickupCoordinates != null and pickupCoordinates != ''">pickup_coordinates,</if>
            <if test="deliveryCoordinates != null and deliveryCoordinates != ''">delivery_coordinates,</if>
            <if test="price != null">price,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="taskType != null">#{taskType},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="pickupLocation != null and pickupLocation != ''">#{pickupLocation},</if>
            <if test="deliveryLocation != null and deliveryLocation != ''">#{deliveryLocation},</if>
            <if test="deadline != null">#{deadline},</if>
            <if test="status != null">#{status},</if>
            <if test="paymentStatus != null">#{paymentStatus},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="imagesUrl != null and imagesUrl != ''">#{imagesUrl},</if>
            <if test="pickupCoordinates != null and pickupCoordinates != ''">#{pickupCoordinates},</if>
            <if test="deliveryCoordinates != null and deliveryCoordinates != ''">#{deliveryCoordinates},</if>
            <if test="price != null">#{price},</if>
         </trim>
    </insert>

    <update id="updateTasks" parameterType="Tasks">
        update tasks
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="taskType != null">task_type = #{taskType},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="pickupLocation != null and pickupLocation != ''">pickup_location = #{pickupLocation},</if>
            <if test="deliveryLocation != null and deliveryLocation != ''">delivery_location = #{deliveryLocation},</if>
            <if test="deadline != null">deadline = #{deadline},</if>
            <if test="status != null">status = #{status},</if>
            <if test="paymentStatus != null">payment_status = #{paymentStatus},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="imagesUrl != null and imagesUrl != ''">images_url = #{imagesUrl},</if>
            <if test="pickupCoordinates != null and pickupCoordinates != ''">pickup_coordinates = #{pickupCoordinates},</if>
            <if test="deliveryCoordinates != null and deliveryCoordinates != ''">delivery_coordinates = #{deliveryCoordinates},</if>
            <if test="price != null">price = #{price},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteTasksByTaskId" parameterType="Long">
        delete from tasks where task_id = #{taskId}
    </delete>

    <delete id="deleteTasksByTaskIds" parameterType="String">
        delete from tasks where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>